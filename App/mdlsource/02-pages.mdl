          textbox txtDayNumber (label: 'Day number', attribute: DayNumber)
          datepicker dpDayDate (label: 'Date', attribute: DayDate)
          textbox txtHeading (label: 'Heading', attribute: Heading)

          footer footerDay {
            actionbutton btnSave (caption: 'Save', action: save_changes close_page, buttonstyle: success)
            actionbutton btnCancel (caption: 'Cancel', action: cancel_changes close_page)
          }
        }
      }
    }
  }
}
/

/**
 * Create / edit form for an Activity.
 *
 * @since 1.0.0
 */
create or replace page "Travel"."Activity_NewEdit"
(
  params: { $Activity: "Travel"."Activity" },
  title: 'Activity',
  layout: Atlas_Core.PopupLayout,
  folder: 'NewEdit'
)
{
  layoutgrid gridMain {
    row rowMain {
      column colMain (desktopwidth: autofill) {
        dataview dvActivity (datasource: $Activity) {
          textbox txtName (label: 'Name', attribute: Name)
          combobox cbCategory (label: 'Category', attribute: "Category")
          datepicker dpStart (label: 'Start time', attribute: StartTime)
          datepicker dpEnd (label: 'End time', attribute: EndTime)
          textbox txtLocation (label: 'Location', attribute: Location)
          textbox txtAddress (label: 'Address', attribute: Address)
          textbox txtCost (label: 'Cost', attribute: Cost)
          checkbox cbBooked (label: 'Booked', attribute: Booked)
          textarea txtNotes (label: 'Notes', attribute: Notes)

          footer footerActivity {
            actionbutton btnSave (caption: 'Save', action: save_changes close_page, buttonstyle: success)
            actionbutton btnCancel (caption: 'Cancel', action: cancel_changes close_page)
          }
        }
      }
    }
  }
}
/

-- MARK: NEW-OBJECT MICROFLOWS

/**
 * Create a new Day for a Trip and open its edit page.
 *
 * Computes the next sequential DayNumber and pre-fills the date from the
 * Trip's start date.
 *
 * @param $Trip The trip to add a day to
 * @returns true
 * @since 1.0.0
 */
create microflow "Travel"."ACT_Day_New" (
  $Trip: "Travel"."Trip"
)
returns Boolean as $ok
folder 'NewEdit'
begin
  retrieve $ExistingDays from "Travel"."Day" where [Travel.Trip_Day = $Trip];
  declare $Count integer = 0;
  loop $Day in $ExistingDays
  begin
    set $Count = $Count + 1;
  end loop;
  $NewDay = create "Travel"."Day" (DayNumber = $Count + 1, DayDate = $Trip/StartDate);
  set $NewDay/Travel.Trip_Day = $Trip;
  show page "Travel"."Day_NewEdit"($Day = $NewDay);
  return true;
end;
/

/**
 * Create a new Activity for a Day and open its edit page.
 *
 * @param $Day The day to add an activity to
 * @returns true
 * @since 1.0.0
 */
create microflow "Travel"."ACT_Activity_New" (
  $Day: "Travel"."Day"
)
returns Boolean as $ok
folder 'NewEdit'
begin
  $NewActivity = create "Travel"."Activity" (Name = 'New activity');
  set $NewActivity/Travel.Day_Activity = $Day;
  show page "Travel"."Activity_NewEdit"($Activity = $NewActivity);
  return true;
end;
/

-- MARK: TRIP DETAIL (master-detail)

/**
 * Trip detail page.
 *
 * Shows the trip header, the trip's Days down the left, and the selected
 * Day's Activities as a time-ordered timeline on the right.
 *
 * @since 1.0.0
 */
create or replace page "Travel"."Trip_Detail"
(
  params: { $Trip: "Travel"."Trip" },
  title: 'Trip detail',
  layout: Atlas_Core.Atlas_Default
)
{
  dataview dvTripHeader (datasource: $Trip, class: 'trip-header') {
    pluggablewidget 'com.mendix.widget.web.image.Image' imgHeaderCover (
      ImageType: 'imageUrl',
      imageUrl: '{CoverImageUrl}',
      isBackgroundImage: true,
      widthUnit: percentage, width: 100,
      heightUnit: pixels, height: 200
    ) {
      container ctnHeaderOverlay (class: 'trip-header-overlay') {
        dynamictext dtTitle (content: '{1}', contentparams: [{1} = Title], rendermode: H1)
        dynamictext dtDestination (content: '{1}', contentparams: [{1} = Destination], rendermode: H4)
      }
    }
    container ctnHeaderMeta (class: 'trip-header-meta') {
      container ctnBadge (class: 'trip-status-badge') {
        dynamictext dtStatus (content: '{1}', contentparams: [{1} = "Status"])
      }
      dynamictext dtDates (content: '{1}  —  {2}', contentparams: [{1} = StartDate, {2} = EndDate])
      dynamictext dtBudget (content: 'Budget: {1}', contentparams: [{1} = Budget])
      actionbutton btnEditTrip (caption: 'Edit Trip', action: show_page Travel.Trip_NewEdit($Trip = $Trip), buttonstyle: default)
    }
    container ctnSummary (class: 'trip-summary') {
      dynamictext dtSummary (content: '{1}', contentparams: [{1} = Summary])
    }
  }

  layoutgrid gridDetail {
    row rowDetail {
      column colDays (desktopwidth: 4, class: 'agenda-days') {
        container ctnDaysHead (class: 'section-head') {
          dynamictext dtDaysTitle (content: 'Itinerary', rendermode: H3)
          actionbutton btnAddDay (caption: 'Add Day', action: microflow Travel.ACT_Day_New($Trip = $Trip), buttonstyle: primary)
        }
        gallery galDays (
          datasource: database from "Travel"."Day" where [Travel.Trip_Day = $Trip] sort by DayNumber asc,
          selection: single,
          DesktopColumns: 1, TabletColumns: 1, PhoneColumns: 1
        ) {
          template tplDay {
            container ctnDayCard (class: 'day-card') {
              dynamictext dtDayNum (content: 'Day {1}', contentparams: [{1} = DayNumber], rendermode: H5)
              dynamictext dtDayHeading (content: '{1}', contentparams: [{1} = Heading])
              dynamictext dtDayDate (content: '{1}', contentparams: [{1} = DayDate])
            }
          }
        }
      }
      column colAgenda (desktopwidth: 8, class: 'agenda-timeline') {
        dataview dvDay (datasource: selection galDays) {
          container ctnDayHead (class: 'section-head') {
            dynamictext dtSelDay (content: 'Day {1}  ·  {2}', contentparams: [{1} = DayNumber, {2} = Heading], rendermode: H3)
            actionbutton btnEditDay (caption: 'Edit Day', action: show_page Travel.Day_NewEdit($Day = $currentObject), buttonstyle: default)
            actionbutton btnAddActivity (caption: 'Add Activity', action: microflow Travel.ACT_Activity_New($Day = $currentObject), buttonstyle: primary)
          }
          listview lvActivities (datasource: $currentObject/Travel.Day_Activity) {
            template tplActivity {
              container ctnActivityRow (class: 'activity-row') {
                container ctnActivityTime (class: 'activity-time') {
                  dynamictext dtActTime (content: '{1}', contentparams: [{1} = StartTime])
                }
                container ctnActivityBody (class: 'activity-body') {
                  container ctnActivityCat (class: 'activity-cat') {
                    dynamictext dtActCat (content: '{1}', contentparams: [{1} = "Category"])
                  }
                  dynamictext dtActName (content: '{1}', contentparams: [{1} = Name], rendermode: H5)
                  dynamictext dtActLoc (content: '{1}', contentparams: [{1} = Location])
                  dynamictext dtActCost (content: 'Cost: {1}', contentparams: [{1} = Cost])
                }
                container ctnActivityActions (class: 'activity-actions') {
                  actionbutton btnEditAct (caption: 'Edit', action: show_page Travel.Activity_NewEdit($Activity = $currentObject), buttonstyle: default)
                }
              }
            }
          }
        }
      }
    }
  }
}
/

-- MARK: TRIPS OVERVIEW (card gallery)

/**
 * Trips overview.
 *
 * A responsive gallery of trip cards (cover image, title, destination,
 * date range, status badge). Clicking a card opens Trip_Detail.
 *
 * @since 1.0.0
 */
create or replace page "Travel"."Trips_Overview"
(
  title: 'Trips',
  layout: Atlas_Core.Atlas_Default
)
{
  container ctnHeader (class: 'page-header') {
    dynamictext dtPageTitle (content: 'My Trips', rendermode: H1)
    dynamictext dtPageSub (content: 'Plan your next adventure, day by day.')
    actionbutton btnNewTrip (caption: 'New Trip', action: create_object "Travel"."Trip" then show_page Travel.Trip_NewEdit, buttonstyle: primary)
  }

  gallery galTrips (
    datasource: database from "Travel"."Trip" sort by StartDate asc,
    selection: none,
    DesktopColumns: 3, TabletColumns: 2, PhoneColumns: 1,
    class: 'trips-gallery'
  ) {
    template tplTrip {
      container ctnCard (class: 'trip-card', OnClick: show_page Travel.Trip_Detail($Trip = $currentObject)) {
        pluggablewidget 'com.mendix.widget.web.image.Image' imgCover (
          ImageType: 'imageUrl',
          imageUrl: '{CoverImageUrl}',
          isBackgroundImage: true,
          widthUnit: percentage, width: 100,
          heightUnit: pixels, height: 160
        ) {
          container ctnBadge (class: 'trip-status-badge') {
            dynamictext dtStatus (content: '{1}', contentparams: [{1} = "Status"])
          }
        }
        container ctnCardBody (class: 'trip-card-body') {
          dynamictext dtTitle (content: '{1}', contentparams: [{1} = Title], rendermode: H4)
          dynamictext dtDest (content: '{1}', contentparams: [{1} = Destination])
          dynamictext dtDates (content: '{1}  —  {2}', contentparams: [{1} = StartDate, {2} = EndDate])
        }
      }
    }
  }
}
/

-- MARK: NAVIGATION

/**
 * Set the Trips overview as the home page and add a "Trips" menu item.
 */
create or replace navigation Responsive
  home page "Travel"."Trips_Overview"
  menu (
    menu item 'Trips' page "Travel"."Trips_Overview";
  );
/
