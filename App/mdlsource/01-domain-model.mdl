-- ============================================================================
-- Travel Itinerary Planner — Domain Model
-- ============================================================================
-- A traveler plans Trips; each Trip has a day-by-day agenda (Days); each Day
-- has timed Activities (sights, food, lodging, transport).
--
-- *Label attributes* (DateRangeLabel / DateLabel / TimeLabel) hold pre-formatted
-- display strings, because dynamictext contentparams can only bind attributes
-- (not formatDateTime expressions). They are populated by the seed / add flows.
-- ============================================================================

/**
 * Travel itinerary planning module (Wanderlog-style day-by-day planner).
 * @since 1.0.0
 */
create module "Travel";

-- MARK: ENUMERATIONS

/**
 * Lifecycle status of a Trip (drives the colored status badge).
 * @since 1.0.0
 */
create enumeration "Travel"."ENUM_TripStatus" (
  "Planning"  'Planning',
  "Booked"    'Booked',
  "Completed" 'Completed'
);

/**
 * Category of an Activity (drives the timeline chip/icon).
 * @since 1.0.0
 */
create enumeration "Travel"."ENUM_ActivityCategory" (
  "Sightseeing" 'Sightseeing',
  "Food"        'Food & Drink',
  "Lodging"     'Lodging',
  "Transport"   'Transport',
  "Activity"    'Activity',
  "Other"       'Other'
);

-- MARK: CORE ENTITIES

/**
 * A planned trip. Top-level container for an itinerary; owns a collection of Days.
 * @since 1.0.0
 * @see Travel.Day
 */
@position(100, 100)
create persistent entity "Travel"."Trip" (
  /** Trip title, e.g. "Tokyo Spring" */
  "Title": string(200) not null error 'Title is required',
  /** Primary destination, e.g. "Tokyo, Japan" */
  "Destination": string(200) not null error 'Destination is required',
  /** First day of the trip */
  "StartDate": date,
  /** Last day of the trip */
  "EndDate": date,
  /** Public URL (or app path) of the cover image shown on the trip card */
  "CoverImageUrl": string(500),
  /** Free-text overview / summary of the trip */
  "Summary": string,
  /** Estimated total budget for the trip */
  "Budget": decimal,
  /** Pre-formatted date range for display, e.g. "Aug 18, 2026 — Aug 21, 2026" */
  "DateRangeLabel": string(100),
  /** Planning lifecycle status */
  "Status": enumeration("Travel"."ENUM_TripStatus") not null error 'Status is required' default "Travel"."ENUM_TripStatus"."Planning"
);

/**
 * A single day within a Trip's agenda. Holds the FK to its Trip; owns Activities.
 * @since 1.0.0
 * @see Travel.Trip
 * @see Travel.Activity
 */
@position(450, 100)
create persistent entity "Travel"."Day" (
  /** Calendar date of this day */
  "DayDate": date,
  /** Sequential day number within the trip (Day 1, Day 2, ...) */
  "DayNumber": integer,
  /** Short heading for the day, e.g. "Arrival & Shibuya" */
  "Heading": string(200),
  /** Pre-formatted day label for display, e.g. "Tue, Aug 19" */
  "DateLabel": string(100)
);

/**
 * A timed activity within a Day. Holds the FK to its Day.
 * @since 1.0.0
 * @see Travel.Day
 */
@position(800, 100)
create persistent entity "Travel"."Activity" (
  /** Activity name, e.g. "Senso-ji Temple" */
  "Name": string(200) not null error 'Name is required',
  /** Activity category (drives the timeline chip) */
  "Category": enumeration("Travel"."ENUM_ActivityCategory") not null error 'Category is required' default "Travel"."ENUM_ActivityCategory"."Sightseeing",
  /** Scheduled start time */
  "StartTime": datetime,
  /** Scheduled end time */
  "EndTime": datetime,
  /** Place / venue name */
  "Location": string(300),
  /** Full street address */
  "Address": string(500),
  /** Free-text notes and tips */
  "Notes": string,
  /** Estimated cost of this activity */
  "Cost": decimal,
  /** Whether this activity is already booked / reserved */
  "Booked": boolean default false,
  /** Pre-formatted time range for display, e.g. "15:00 – 16:00" */
  "TimeLabel": string(100)
);

-- MARK: ASSOCIATIONS

/**
 * Links each Day to its Trip (FK on Day). A Trip has many Days.
 * @since 1.0.0
 */
create association "Travel"."Trip_Day"
from "Travel"."Day" to "Travel"."Trip"
type reference
owner default
delete_behavior DELETE_AND_REFERENCES
comment 'A Trip has many Days; deleting a Trip deletes its Days.';

/**
 * Links each Activity to its Day (FK on Activity). A Day has many Activities.
 * @since 1.0.0
 */
create association "Travel"."Day_Activity"
from "Travel"."Activity" to "Travel"."Day"
type reference
owner default
delete_behavior DELETE_AND_REFERENCES
comment 'A Day has many Activities; deleting a Day deletes its Activities.';
